# --- Sarvam AI (STT only) --- https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_STT_MODEL=saarika:v2.5

# --- Bhashini AI (TTS) --- https://pay.bhashini.ai
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_TTS_VOICE_EN=Female3
BHASHINI_TTS_VOICE_HI=hi-f3
BHASHINI_TTS_STYLE=Neutral
BHASHINI_TTS_BASE_URL=https://tts.bhashini.ai

# --- Google Gemini (LLM) --- https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Twilio --- https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# --- App ---
# Public HTTPS URL of this server (ngrok in local dev, e.g. https://abc123.ngrok-free.app)
BASE_URL=https://your-public-url
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Conversation tuning ---
# Language used before the caller's language is detected (BCP-47, e.g. hi-IN, en-IN, ta-IN)
DEFAULT_LANGUAGE=hi-IN
# RMS energy above this counts as speech (raise if noisy lines trigger false turns)
SILENCE_THRESHOLD_RMS=300
# Seconds of silence that end the caller's turn
SILENCE_END_SECONDS=0.8
# Utterances shorter than this (speech seconds) are ignored
MIN_UTTERANCE_SECONDS=0.3
