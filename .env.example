# MiraeVaani 6.0 — infrastructure settings only.
# Provider API keys are NOT here: enter them in the UI (Credentials page),
# where they are encrypted with APP_SECRET before being written to SQLite.

# Public HTTPS URL Twilio calls back on. With ngrok:  ngrok http 8000
BASE_URL=https://your-tunnel.ngrok-free.app

APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOGS_DIR=logs
DB_PATH=miraevaani.db

# Encrypts stored credentials. Change this and every saved key must be re-entered.
APP_SECRET=pick-a-long-random-string
