# ============================================================
# MiraeVaani 2.0 — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- Twilio (keep from v1) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX

# --- Colab GPU Service URLs (paste from Colab notebook output) ---
# Run colab/miraevaani_gpu_services.ipynb and copy the ngrok URLs here.
STT_BASE_URL=https://xxxx.ngrok-free.app
LLM_BASE_URL=https://yyyy.ngrok-free.app
TTS_BASE_URL=https://zzzz.ngrok-free.app

# --- LLM Settings ---
LLM_MODEL=gemma2:9b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=120

# --- STT Settings ---
# "auto" to auto-detect language, or set explicit: hi, ta, te, mr, bn, gu, kn, ml, pa
STT_LANGUAGE=auto
STT_WHISPER_MODEL=large-v3

# --- TTS Settings ---
TTS_DEFAULT_LANGUAGE=hi
TTS_SPEAKER=Ana Florence

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
# Your public URL (ngrok) that Twilio can reach — run: ngrok http 8000
BASE_URL=https://your-ngrok-url.ngrok-free.app
LOG_LEVEL=INFO
